@page "/"
@using Dagucar.Services
@using System.Collections.ObjectModel
@using System.Linq

@inject IBluetoothService bluetoothService;
@inject NavigationManager NavigationManager;

<h1>Hello, world!</h1>

Welcome to your new app.

<span class="input-group">
    @{
        if (isDiscovering)
        {
            <button class="btn btn-secondary" @onclick="StopDiscovery">Stop Discovery</button>
        }
        else
        {
            <button class="btn btn-secondary" @onclick="StartDiscovery">Start Discovery</button>
        }
    }
</span>
<h2>Found devices</h2>
<ul class="list-group">
    @foreach (var device in devices)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>@device.Name</span>
            <div class="btn-group">
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => CreateBond(device)">Bond</button>
                <button class="btn btn-primary btn-sm" @onclick="() => ConnectToDevice(device)">Connect</button>
            </div>
        </li>
    }
</ul>
<h2>Bonded devices</h2>
<ul class="list-group">
    @foreach (var device in bondedDevices)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>@device.Name</span>
            <button class="btn btn-primary btn-sm" @onclick="() => ConnectToDevice(device)">Connect</button>
        </li>
    }
</ul>

@code
{
    private bool isDiscovering = false;
    private ObservableCollection<BluetoothDevice> devices = new();
    private ObservableCollection<BluetoothDevice> bondedDevices = new();
    private readonly string[] legoAddressPrefixes = new[] { "90:84:2B", "58:2B:DB", "7C:66:9D" }; // common LEGO Control+ hubs
    private readonly string[] dagucarAddressPrefixes = new[] { "98:D3:31", "00:21:13", "D8:A0:1D" }; // adjust to your DaguCar module

    override protected async Task OnInitializedAsync()
    {
        this.bondedDevices.Clear();
        var bondedDevices = await bluetoothService.GetBondedDevices();
        foreach (var device in bondedDevices)
            this.bondedDevices.Add(device);
    }

    private async Task StartDiscovery()
    {
        isDiscovering = true;
        devices.Clear();
        await Task.Delay(10);
        var success = await bluetoothService.StartDiscovery(OnDeviceDiscovered, OnDiscoveryFinished);
    }

    private async Task OnDeviceDiscovered(BluetoothDevice device)
    {
        await InvokeAsync(() =>
        {
            devices.Add(device);
            StateHasChanged(); // Have to do this before the UI updates
        });
    }

    private async Task OnDiscoveryFinished()
    {
        await InvokeAsync(() =>
        {
            isDiscovering = false;
            StateHasChanged(); // Have to do this before the UI updates
        });
    }

    private async Task StopDiscovery()
    {
        var cancelled = await bluetoothService.StopDiscovery();
        // Why do i need to call this?
        await OnDiscoveryFinished();
    }

    private async Task CreateBond(BluetoothDevice device)
    {
        await bluetoothService.CreateBond(device);
    }

    private Task ConnectToDevice(BluetoothDevice device)
    {
        var target = device ?? throw new ArgumentNullException(nameof(device));
        var address = target.Address ?? string.Empty;

        if (IsLegoDevice(target))
        {
            NavigateToControl("/lego", target);
        }
        else if (IsDagucarDevice(target))
        {
            NavigateToControl("/dagucar", target);
        }

        return Task.CompletedTask;
    }

    private void NavigateToControl(string basePath, BluetoothDevice device)
    {
        var addr = Uri.EscapeDataString(device.Address ?? string.Empty);
        var name = Uri.EscapeDataString(device.Name ?? string.Empty);
        NavigationManager.NavigateTo($"{basePath}?addr={addr}&name={name}");
    }

    private bool IsLegoDevice(BluetoothDevice device)
    {
        if (!string.IsNullOrWhiteSpace(device.Name) && device.Name.Contains("LEGO", StringComparison.OrdinalIgnoreCase))
            return true;

        return legoAddressPrefixes.Any(p => (device.Address ?? string.Empty).StartsWith(p, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsDagucarDevice(BluetoothDevice device)
    {
        return dagucarAddressPrefixes.Any(p => (device.Address ?? string.Empty).StartsWith(p, StringComparison.OrdinalIgnoreCase));
    }
}
